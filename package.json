{
  "name": "pantrypilot-api-vertical-slice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "cross-env RUN_INTEGRATION=true vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "openapi": "tsx scripts/write-openapi.ts",
    "validate": "npm run lint && npm run test && npm run build && npm run openapi",
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "build:full": "prisma generate && tsc -p tsconfig.build.json",
    "sessions:cleanup": "tsx src/cleanup-sessions.ts",
    "sanitize:ascii": "node tools/sanitize-ascii.mjs src",
    "validate:ascii": "node tools/validate-ascii.mjs src"
  },
  "dependencies": {
    "@azure/msal-node": "^3.7.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "^6.16.2",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "jose": "^6.1.0",
    "openai": "^7.27.0",
    "pino": "^9.9.4",
    "prisma": "^6.16.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.5.1",
    "@types/node": "^24.5.2",
    "cross-env": "^10.1.0",
    "testcontainers": "^11.5.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
